# Copy this file to .env (or run `npm run setup`, which does it for you) and fill in the values.
# Never commit .env.

# --- Database -------------------------------------------------------------------------------
# Supabase: Project Settings > Database > Connection string. Ask Ahmet for the password.
# Local development without Supabase: run `npm run db:local`; `npm run setup` then writes
#   postgresql://postgres:postgres@localhost:5433/pokemon_shop
# into both variables below.

# Used by the running app: transaction pooler, port 6543.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Used by Prisma migrations: session pooler, port 5432 (works without IPv6).
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Set to true only if the app cannot connect to Supabase and the error mentions SSL.
DATABASE_SSL=false

# --- API ------------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters
# Token lifetime (15m, 12h, 1d, 7d ...)
JWT_EXPIRES_IN=1d

# Secret for HMAC-signing stored card numbers (req. 17). At least 32 random characters.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CARD_HMAC_SECRET=replace-with-at-least-32-random-characters

# Password hashing cost (10-12 recommended; higher is slower)
BCRYPT_ROUNDS=10

# Address of the React app (Vite default). Separate several origins with commas.
CLIENT_ORIGIN=http://localhost:5173

# Login/register requests allowed per IP per 15 minutes
AUTH_RATE_LIMIT=20
