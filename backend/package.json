{
  "name": "cs308-backend",
  "version": "1.0.0",
  "description": "Backend for the CS 308 online store",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "format": "prettier --write .",
    "setup": "node scripts/setup.js",
    "db:local": "node scripts/dev-db.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test:db": "node --test tests/db/*.test.mjs"
  },
  "type": "commonjs",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "16.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.16.0",
    "pg": "^8.16.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "embedded-postgres": "18.6.0-beta.19",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "prisma": "7.10.1",
    "supertest": "^7.3.2"
  }
}
