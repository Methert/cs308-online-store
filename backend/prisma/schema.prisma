// Database schema for the CS 308 online store.
// Owner: Ahmet. Request changes through an issue; never edit a migration that was already applied.
// Rules Prisma cannot express (CHECK constraints) live in the migration SQL.

generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  generatedFileExtension = "mts"
  importFileExtension    = "mts"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  customer
  sales_manager
  product_manager
  support_agent

  @@map("user_role")
}

enum OrderStatus {
  processing
  in_transit
  delivered
  cancelled

  @@map("order_status")
}

enum CommentStatus {
  pending
  approved
  rejected

  @@map("comment_status")
}

// Physical condition of a second-hand card, best to worst.
enum CardCondition {
  mint
  near_mint
  excellent
  good
  played
  poor

  @@map("card_condition")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(customer)
  // Requirement 14: a customer has a tax ID. Staff accounts have none, so it is optional here
  // and the registration API makes it mandatory for customers.
  taxId        String?  @map("tax_id")
  homeAddress  String?  @map("home_address")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  cart             Cart?
  orders           Order[]
  reviews          Review[] @relation("ReviewAuthor")
  moderatedReviews Review[] @relation("ReviewModerator")

  @@map("users")
}

// Each category is a card set (the pack a card comes from), for example "Scarlet & Violet 151".
model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  // The set's code in the Pokémon TCG data, for example "sv3pt5".
  setCode     String?   @unique @map("set_code")
  // The era the set belongs to, for example "Scarlet & Violet".
  series      String?
  releaseDate DateTime? @map("release_date") @db.Date

  products Product[]

  @@map("categories")
}

model Product {
  id             Int           @id @default(autoincrement())
  categoryId     Int           @map("category_id")
  name           String
  // A product is one second-hand card in one condition. The same card in another condition is
  // another product with its own price and stock. The card's set is its category.
  // model: the card's number in its set, for example "199/165".
  model          String
  // serialNumber: the shop's own stock code for this product.
  serialNumber   String        @unique @map("serial_number")
  // As printed on the card, for example "Special Illustration Rare".
  rarity         String
  condition      CardCondition @default(near_mint)
  description    String
  stockQuantity  Int           @default(0) @map("stock_quantity")
  price          Decimal       @db.Decimal(10, 2)
  // Empty cost means half of the price in profit calculations (requirement 11).
  cost           Decimal?      @db.Decimal(10, 2)
  // For a second-hand card: the authenticity and condition guarantee.
  warrantyStatus String        @map("warranty_status")
  distributor    String
  imageUrl       String?       @map("image_url")
  // Removed products stay in the table so old orders keep their history.
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  category   Category    @relation(fields: [categoryId], references: [id])
  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]

  @@index([categoryId])
  @@index([rarity])
  @@map("products")
}

// A guest cart has a guestToken and no user; after login it is attached to the user (requirement 4).
model Cart {
  id         Int      @id @default(autoincrement())
  userId     Int?     @unique @map("user_id")
  guestToken String?  @unique @map("guest_token")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  cartId    Int @map("cart_id")
  productId Int @map("product_id")
  quantity  Int

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@id([cartId, productId])
  @@map("cart_items")
}

model Order {
  id              Int         @id @default(autoincrement())
  userId          Int         @map("user_id")
  status          OrderStatus @default(processing)
  totalPrice      Decimal     @map("total_price") @db.Decimal(10, 2)
  deliveryAddress String      @map("delivery_address")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  user    User        @relation(fields: [userId], references: [id])
  items   OrderItem[]
  payment Payment?
  invoice Invoice?

  @@index([userId])
  @@index([status])
  @@map("orders")
}

// The mock bank's approval for an order (requirements 4 and 15). Only approved payments are
// stored: a declined card creates no order.
model Payment {
  id            Int      @id @default(autoincrement())
  orderId       Int      @unique @map("order_id")
  amount        Decimal  @db.Decimal(10, 2)
  cardHolder    String   @map("card_holder")
  // The full card number is never stored, only its last four digits and a hash (requirement 17).
  cardLast4     String   @map("card_last4") @db.Char(4)
  cardHash      String   @map("card_hash")
  bankReference String   @map("bank_reference")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}

// One invoice per order, shown after payment and emailed as a PDF (requirement 4).
// Managers list invoices by date range (requirements 11 and 12).
model Invoice {
  id            Int       @id @default(autoincrement())
  orderId       Int       @unique @map("order_id")
  invoiceNumber String    @unique @map("invoice_number")
  totalPrice    Decimal   @map("total_price") @db.Decimal(10, 2)
  pdfPath       String?   @map("pdf_path")
  emailedAt     DateTime? @map("emailed_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id])

  @@index([createdAt])
  @@map("invoices")
}

// The delivery list of requirement 12 is the database view "delivery_list", defined in the
// migration SQL (Prisma does not manage views). Query it with prisma.$queryRaw.

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  productId Int     @map("product_id")
  quantity  Int
  // The price actually paid, after any discount. Refunds use this value (requirement 16).
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  review  Review?

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// One review per purchased order line, only after delivery (requirement 5).
// The rating is visible at once; the comment waits for a product manager.
model Review {
  id            Int            @id @default(autoincrement())
  orderItemId   Int            @unique @map("order_item_id")
  userId        Int            @map("user_id")
  productId     Int            @map("product_id")
  rating        Int
  comment       String?
  commentStatus CommentStatus? @map("comment_status")
  moderatedBy   Int?           @map("moderated_by")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  user      User      @relation("ReviewAuthor", fields: [userId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  moderator User?     @relation("ReviewModerator", fields: [moderatedBy], references: [id])

  @@index([productId])
  @@map("reviews")
}
