# Example requests for trying out the API.
# Install the "REST Client" extension (Huachao Mao) in VS Code, then click the
# "Send Request" text that appears above each request. Start the server first: npm run dev

@base = http://localhost:3000/api

### Are the server and the database up?
GET {{base}}/health

### Register (customer)
# @name register
POST {{base}}/auth/register
Content-Type: application/json

{
  "name": "Ash Ketchum",
  "email": "ash@pokeshop.test",
  "password": "Pikachu123",
  "taxId": "12345678901",
  "homeAddress": "Pallet Town, Route 1, No: 5"
}

### Log in
# @name login
POST {{base}}/auth/login
Content-Type: application/json

{
  "email": "ash@pokeshop.test",
  "password": "Pikachu123"
}

### My profile (automatically uses the token from the login response above)
GET {{base}}/auth/me
Authorization: Bearer {{login.response.body.data.token}}

### Log in as product manager (after npm run db:seed)
POST {{base}}/auth/login
Content-Type: application/json

{
  "email": "pm@pokeshop.test",
  "password": "Manager123"
}

### Invalid registration: returns 400 and a list of errors per field
POST {{base}}/auth/register
Content-Type: application/json

{
  "name": "A",
  "email": "not-an-email",
  "password": "123"
}

### Profile without a token: returns 401
GET {{base}}/auth/me

### ---------------------------------------------------------------------------
### Products and categories (after npm run db:seed)
### ---------------------------------------------------------------------------

### All card sets with their number of products
GET {{base}}/categories

### First page of products (sorted by name, 20 per page)
GET {{base}}/products

### Search in name or description, cheapest first
GET {{base}}/products?q=charizard&sort=price_asc

### Best sellers first, second page of 10
GET {{base}}/products?sort=popularity&limit=10&page=2

### Products of one card set
GET {{base}}/categories/1/products?sort=price_desc

### Product detail
GET {{base}}/products/1

### Invalid sort: returns 400 with the allowed values
GET {{base}}/products?sort=cheapest

### Log in as product manager for the requests below
# @name pmLogin
POST {{base}}/auth/login
Content-Type: application/json

{
  "email": "pm@pokeshop.test",
  "password": "Manager123"
}

### Manager list, including removed products and the cost
GET {{base}}/products/manage?status=all
Authorization: Bearer {{pmLogin.response.body.data.token}}

### Add a product
# @name newProduct
POST {{base}}/products
Authorization: Bearer {{pmLogin.response.body.data.token}}
Content-Type: application/json

{
  "categoryId": 1,
  "name": "Mew ex",
  "model": "193/165",
  "serialNumber": "DEMO-193-NM",
  "rarity": "Ultra Rare",
  "description": "A full-art Mew ex.",
  "price": 19.9,
  "cost": 8,
  "stockQuantity": 5,
  "warrantyStatus": "Authenticity guaranteed; condition as described",
  "distributor": "The Pokémon Company International"
}

### Change its price
PATCH {{base}}/products/{{newProduct.response.body.data.product.id}}
Authorization: Bearer {{pmLogin.response.body.data.token}}
Content-Type: application/json

{
  "price": 24.9
}

### Add 3 copies to the stock
PATCH {{base}}/products/{{newProduct.response.body.data.product.id}}/stock
Authorization: Bearer {{pmLogin.response.body.data.token}}
Content-Type: application/json

{
  "change": 3
}

### Set the stock to an exact number
PATCH {{base}}/products/{{newProduct.response.body.data.product.id}}/stock
Authorization: Bearer {{pmLogin.response.body.data.token}}
Content-Type: application/json

{
  "stockQuantity": 10
}

### Take it off sale (it stays in the database for old orders)
DELETE {{base}}/products/{{newProduct.response.body.data.product.id}}
Authorization: Bearer {{pmLogin.response.body.data.token}}

### Add a card set
POST {{base}}/categories
Authorization: Bearer {{pmLogin.response.body.data.token}}
Content-Type: application/json

{
  "name": "Paldean Fates",
  "setCode": "sv04.5",
  "series": "Scarlet & Violet",
  "releaseDate": "2024-01-26"
}
